ENV=dev
DATABASE_URL=postgresql+psycopg2://aistock:aistock_dev@localhost:5432/aistock
REDIS_URL=redis://localhost:6379/1
JWT_SECRET=change-me-to-a-32-char-random-string
DEEPSEEK_API_KEY=
DEBUG=true

# DataHub 配置凭证加密主密钥（64 位十六进制 / 32 bytes）。
# 本地开发可留空，应用会从 JWT_SECRET 派生；生产必须填写独立随机值，禁止使用固定示例密钥。
DATAHUB_CONFIG_ENCRYPTION_KEY=

# ===== SMTP 邮件配置（注册/忘记密码需要）=====
# 开发模式 EMAIL_ENABLED=false，验证码打印到服务器日志
# 上线前改为 true 并填写邮箱授权码（QQ邮箱/163邮箱均可）
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_auth_code
SMTP_FROM=your_email@qq.com
SMTP_USE_SSL=true
