# ===== 睿见投研 生产环境变量（复制为 deploy/.env 后填写）=====

# PostgreSQL 密码（强密码，别用默认）
POSTGRES_PASSWORD=change-me-strong-password

# JWT 签名密钥：openssl rand -hex 32 生成
JWT_SECRET=change-me-64-hex-chars

# DeepSeek API Key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=

# 上线前先 false 用真实模型；调试期可 true 省钱
LLM_MOCK=false
LLM_MODEL=deepseek-chat

# 每日 LLM token 用量上限（保险丝）
DAILY_TOKEN_LIMIT=2000000
