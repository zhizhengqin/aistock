# ===== 睿见投研 生产环境变量（复制为 deploy/.env 后填写）=====

# PostgreSQL 密码（强密码，别用默认）
POSTGRES_PASSWORD=change-me-strong-password

# JWT 签名密钥：openssl rand -hex 32 生成
JWT_SECRET=change-me-64-hex-chars

# 观察发布期 bootstrap 输入（https://platform.deepseek.com 申请）。
# 仅在数据库尚无模型配置时使用一次；管理员配置完成后不再覆盖数据库。
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1

# LLM 配置密钥环：使用 32 字节随机值的标准 Base64，JSON 键为密钥 ID。
# 生产环境必须设置当前写入密钥 ID，并保留旧 ID 以支持轮换期间双读。
LLM_CONFIG_ENCRYPTION_KEY_ID=
LLM_CONFIG_ENCRYPTION_KEYS={}

# 观察期结束后另行移除 DEEPSEEK_API_KEY/LLM_MODEL/LLM_BASE_URL。

# 每日 LLM token 用量上限（保险丝）
DAILY_TOKEN_LIMIT=2000000

# ===== 邮件（注册验证码）：不配则验证码只写进 api 容器日志 =====
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
